# 🗄️ Configuração do Banco de Dados PostgreSQL
PGHOST=seu-host-postgres.com
PGDATABASE=nome-do-seu-banco
PGUSER=seu-usuario
PGPASSWORD=sua-senha
PGPORT=5432
PGSSLMODE=require   # use "disable" para um PostgreSQL local sem SSL
PGCHANNELBINDING=require

# 🚀 Configuração do Servidor
PORT=3000
NODE_ENV=development

# 🔒 CORS Configuration (separar múltiplas origens com vírgula)
CORS_ORIGIN=http://localhost:3000,https://seu-frontend.com

# 📊 Configurações de Logging
ENABLE_LOGGING=true
POOL_DEBUG=false

# 🔗 URL completa do banco (alternativa às variáveis separadas)
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco

# 📝 Exemplo de configuração local:
# PGHOST=localhost
# PGDATABASE=rfid_database
# PGUSER=rfid_user
# PGPASSWORD=sua_senha_segura
# PORT=3000

# 📝 Exemplo para Vercel/Neon/Supabase:
# PGHOST=ep-exemplo-123456.us-east-1.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=seu_usuario_neon
# PGPASSWORD=sua_senha_neon
# PGSSLMODE=require
