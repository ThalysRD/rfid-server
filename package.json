{
  "name": "servidor-rfid",
  "version": "2.1.0",
  "description": "API RFID para ESP32 com Node.js, Express e PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "setup": "node -e \"const bd = require('./infra/bancoDados'); bd.testConnection().then(() => console.log('✅ Banco conectado!')).catch(e => console.error('❌ Erro:', e.message))\"",
    "check": "node -c server.js app.js controladores/controladorRFID.js controladores/controladorSaude.js controladores/controladorArquivo.js infra/bancoDados.js rotas/index.js rotas/documentacao.js",
    "bd:testar": "node -e \"require('./infra/bancoDados').testConnection()\"",
    "bd:schema": "psql $DATABASE_URL -f database/schema.sql",
    "iniciar": "npm start",
    "desenvolver": "npm run dev",
    "test:cobertura": "jest --coverage"
  },
  "keywords": [
    "rfid",
    "esp32",
    "postgresql",
    "iot",
    "nodejs",
    "servidor-rfid",
    "leituras-rfid",
    "api-portuguesa",
    "controle-acesso"
  ],
  "author": "ThalysRD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThalysRD/rfid-server.git"
  },
  "bugs": {
    "url": "https://github.com/ThalysRD/rfid-server/issues"
  },
  "homepage": "https://github.com/ThalysRD/rfid-server#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "controladores/**/*.js",
      "rotas/**/*.js",
      "app.js"
    ]
  }
}
